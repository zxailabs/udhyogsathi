# Google Gemini API Key (Required for live AI responses & Google Search Grounding)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Firebase / Firestore FAQ Cache & Grievance Storage
# Leave empty to run seamlessly with local fallback & localStorage
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional: Admin Karyakarta Passcode (defaults to BUA@2026 in demo mode if unset)
NEXT_PUBLIC_ADMIN_PASSCODE=BUA@2026

